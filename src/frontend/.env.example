NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key

# Better Auth server configuration. DATABASE_URL must be the Supabase
# PostgreSQL session-pooler connection string, not the Supabase API URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=replace-with-supabase-session-pooler-url
