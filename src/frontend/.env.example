NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key

# Better Auth server configuration. DATABASE_URL must be the Supabase
# PostgreSQL session-pooler connection string, not the Supabase API URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=replace-with-supabase-session-pooler-uri

# Google OAuth web application credentials.
# Local callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# GitHub OAuth App credentials.
# Local callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Transactional email used for password reset links.
RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=TechBondhu <account@your-verified-domain.com>
